{
  "roles": {
    "developer": {
      "permissions": [
        {"server": "fs", "tool": "list_*"},
        {"server": "fs", "tool": "read_*"},
        {"server": "fs", "resource": "file://${home}/*"},
        {"server": "fs", "tool": "write_file", "require_approval": true, "approval_channel": "form", "args": {"path": "^${home}/"}},
        {"server": "fs", "tool": "delete_*", "effect": "deny"},
        {"server": "*", "prompt": "*"}
      ]
    }
  },
  "bindings": {"groups": {}, "users": {}}
}
