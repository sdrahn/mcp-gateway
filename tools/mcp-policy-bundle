#!/bin/sh
# mcp-policy-bundle: build a signed OPA bundle from the policy logic
# shipped with mcp-gateway and the administrator's role data, for
# mcp-opa.service in signed bundle mode (docs/architecture.md, section
# 5.5). The bundle replaces the output file atomically; unless -n is
# given, mcp-opa.service is then restarted, which verifies the signature.
# With -G it creates a signing key pair on this host instead.
set -eu

usage() {
	cat <<USAGE
Usage: mcp-policy-bundle [-k SIGNING_KEY] [-o OUTPUT] [-r REVISION] [-n]
                         [-V VENDOR_POLICY_DIR] [-L LOCAL_POLICY_DIR]
       mcp-policy-bundle -G [-k SIGNING_KEY] [-o OUTPUT]

  -k  private key (PEM, RSA) to sign the bundle with
      (default: /etc/mcp-gateway/bundle/signing.pem); keeping it off the
      gateway host is safer, keeping it here allows signing from Cockpit
  -G  create a signing key pair: the private key at the -k path (mode
      0600) and the verification key as verify.pem next to OUTPUT
  -a  signing algorithm (default: RS256)
  -o  bundle file (default: /etc/mcp-gateway/bundle/policy.tar.gz)
  -r  revision recorded in the bundle (default: UTC timestamp)
  -n  do not restart mcp-opa.service
  -V  policy logic (default: /usr/share/mcp-gateway/policy)
  -L  role data (default: /etc/mcp-gateway/policy)

Environment: OPA (default: opa from PATH). -G needs openssl.
USAGE
	exit 2
}

key=/etc/mcp-gateway/bundle/signing.pem alg=RS256
out=/etc/mcp-gateway/bundle/policy.tar.gz
revision=$(date -u +%Y%m%dT%H%M%SZ) restart=yes genkey=no
vendor=/usr/share/mcp-gateway/policy local=/etc/mcp-gateway/policy
while getopts k:a:o:r:nGV:L:h opt; do
	case $opt in
	k) key=$OPTARG ;;
	G) genkey=yes ;;
	a) alg=$OPTARG ;;
	o) out=$OPTARG ;;
	r) revision=$OPTARG ;;
	n) restart=no ;;
	V) vendor=$OPTARG ;;
	L) local=$OPTARG ;;
	*) usage ;;
	esac
done
opa=${OPA:-opa}

# relabel gives new files their SELinux label (e.g. mcpgw_signing_key_t).
relabel() {
	if command -v restorecon >/dev/null 2>&1; then
		restorecon -F "$@" 2>/dev/null || true
	fi
}

if [ "$genkey" = yes ]; then
	pub="$(dirname "$out")/verify.pem"
	if [ -e "$key" ]; then
		echo "mcp-policy-bundle: $key exists; not replacing it" >&2
		exit 1
	fi
	mkdir -p "$(dirname "$key")" "$(dirname "$pub")"
	(umask 077 && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$key" 2>/dev/null)
	openssl pkey -in "$key" -pubout -out "$pub.new"
	chmod 0644 "$pub.new"
	mv -f "$pub.new" "$pub"
	relabel "$key" "$pub"
	echo "created signing key $key and verification key $pub"
	exit 0
fi

if [ ! -r "$key" ]; then
	echo "mcp-policy-bundle: cannot read signing key $key (create one with -G, or pass -k)" >&2
	exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir "$tmp/src"
cp -R "$vendor/." "$tmp/src/"
# The administrator's files: Rego files at their relative path, so a file
# at a shipped path replaces the shipped one; data files below data.mcp,
# as mcp-opa.service loads them ("mcp:/etc/mcp-gateway/policy"), so
# rbac/data.json is data.mcp.rbac.
(cd "$local" && find . -type f ! -name '.manifest') | while IFS= read -r f; do
	case $f in
	*/data.json | */data.yaml | */data.yml) dest="$tmp/src/mcp/$f" ;;
	*) dest="$tmp/src/$f" ;;
	esac
	mkdir -p "$(dirname "$dest")"
	cp "$local/$f" "$dest"
done
find "$tmp/src" -name '*_test.rego' -exec rm -f {} +
# The bundle claims only data.mcp, so it can share an OPA with other
# bundles; opa build rejects Rego packages and data outside it.
rm -f "$tmp/src/.manifest"
printf '{"roots": ["mcp"]}\n' >"$tmp/src/.manifest"

"$opa" check --strict "$tmp/src"
"$opa" build --bundle "$tmp/src" --signing-key "$key" --signing-alg "$alg" \
	--revision "$revision" --output "$tmp/bundle.tar.gz"

mkdir -p "$(dirname "$out")"
cp "$tmp/bundle.tar.gz" "$out.new"
chmod 0644 "$out.new"
mv -f "$out.new" "$out"
relabel "$out"
echo "wrote $out (revision $revision)"

if [ "$restart" = yes ] && command -v systemctl >/dev/null 2>&1; then
	systemctl try-restart mcp-opa.service
fi
