[Unit]
Description=MCP gateway
Documentation=https://github.com/sdrahn/mcp-gateway/blob/main/docs/architecture.md
Requires=mcp-opa.service
After=mcp-opa.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-gateway
Group=mcp-gateway
# Backend instances are started as transient units over D-Bus; the
# gateway is allowed to manage mcp-*.service units by
# packaging/polkit/50-mcp-gateway.rules.
ExecStartPre=/usr/bin/mcp-gateway --check
ExecStart=/usr/bin/mcp-gateway
Restart=on-failure
RuntimeDirectory=mcp-gateway
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=mcp-gateway
StateDirectoryMode=0700
ConfigurationDirectory=mcp-gateway

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
