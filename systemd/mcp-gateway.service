[Unit]
Description=MCP gateway
Documentation=https://github.com/sdrahn/mcp-gateway/blob/main/docs/architecture.md
# Wants=, not Requires=: restarting OPA (e.g. for a new signed policy
# bundle) must not restart the gateway and end every session. Without OPA
# the gateway denies all requests.
Wants=mcp-opa.service
After=mcp-opa.service network-online.target
Wants=network-online.target

[Service]
# Ready once its sockets are up; the status line shows sessions, server
# instances and pending approvals. The watchdog restarts a gateway whose
# sessions, instances or approvals stay locked (the Go runtime writes
# every goroutine's stack to the journal first, on SIGABRT).
Type=notify
NotifyAccess=main
WatchdogSec=60s
User=mcp-gateway
Group=mcp-gateway
# The client socket is chgrp'ed to socket_group (gateway.yaml); the gateway
# must be a member of that group to do so without CAP_CHOWN.
SupplementaryGroups=mcp-users
# Backend instances are started as transient units over D-Bus; the
# gateway may manage mcp-*.service units only (polkit rule
# 50-mcp-gateway.rules).
# The configuration only: the role data is OPA's; a mistake there denies
# requests but must not keep the gateway from starting.
ExecStartPre=/usr/bin/mcp-gateway --check --policy-data=
ExecStart=/usr/bin/mcp-gateway
Restart=on-failure
# On stop the gateway waits for calls to privileged servers (package
# installations) to finish, for up to 28 minutes.
TimeoutStopSec=30min
# /run/mcp-gateway is created by tmpfiles.d (mcp-gateway.conf).
ReadWritePaths=/run/mcp-gateway
StateDirectory=mcp-gateway
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
# Only to send audit events to the kernel audit subsystem (audit.kernel).
CapabilityBoundingSet=CAP_AUDIT_WRITE
AmbientCapabilities=CAP_AUDIT_WRITE
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
