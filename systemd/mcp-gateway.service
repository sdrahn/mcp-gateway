[Unit]
Description=MCP gateway
Documentation=https://github.com/sdrahn/mcp-gateway/blob/main/docs/architecture.md
Requires=mcp-opa.service
After=mcp-opa.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp-gateway
Group=mcp-gateway
# Backend instances are started as transient units over D-Bus; the
# gateway may manage mcp-*.service units only (polkit rule
# 50-mcp-gateway.rules).
ExecStartPre=/usr/bin/mcp-gateway --check
ExecStart=/usr/bin/mcp-gateway
Restart=on-failure
RuntimeDirectory=mcp-gateway
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=mcp-gateway
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
