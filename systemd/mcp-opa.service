[Unit]
Description=MCP gateway policy engine (OPA)
Documentation=https://github.com/sdrahn/mcp-gateway/blob/main/docs/architecture.md
Before=mcp-gateway.service

[Service]
Type=simple
User=mcp-opa
Group=mcp-gateway
# Shared with mcp-gateway.service.
RuntimeDirectory=mcp-gateway
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# The distribution's opa binary, entered into its own SELinux domain here
# rather than through a file label ("-": ignored where SELinux is off).
SELinuxContext=-system_u:system_r:mcpopa_t:s0
# Policy logic (vendor, /usr/share) and role data (administrator, /etc).
# Every decision is logged to the journal; policy/system/log.rego masks
# tool arguments, and input.context.decision_id links an entry to the
# gateway's audit record.
ExecStart=/usr/bin/opa run --server \
    --addr unix:///run/mcp-gateway/opa.sock \
    --unix-socket-perm 0660 \
    --watch \
    --log-format json \
    --set=decision_logs.console=true \
    /usr/share/mcp-gateway/policy \
    /etc/mcp-gateway/policy
Restart=on-failure

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
