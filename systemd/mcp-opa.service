[Unit]
Description=MCP gateway policy engine (OPA)
Documentation=https://github.com/sdrahn/mcp-gateway/blob/main/docs/architecture.md
Before=mcp-gateway.service
# The role data, rendered from /etc/mcp-gateway/policy/rbac (data.yaml or
# data.json) to /run/mcp-opa/rbac, and again on every change. Wants=: OPA
# starts without it, and denies what no role allows.
Wants=mcp-policy-render.service
After=mcp-policy-render.service

[Service]
Type=simple
User=mcp-opa
Group=mcp-gateway
# Shared with mcp-gateway.service.
# /run/mcp-gateway is created by tmpfiles.d (mcp-gateway.conf).
ReadWritePaths=/run/mcp-gateway
# The distribution's opa binary, entered into its own SELinux domain here
# rather than through a file label ("-": ignored where SELinux is off).
SELinuxContext=-system_u:system_r:mcpopa_t:s0
# Policy logic (vendor, /usr/share), the administrator's policy (/etc)
# and the role data (rendered, /run/mcp-opa/rbac). Everything lives below
# data.mcp, so the policy can share an OPA with other policies: "mcp:"
# loads the administrator's data files below it; Rego files keep their
# packages. The role data in /etc/mcp-gateway/policy/rbac is not loaded
# from there (--ignore rbac skips every directory of that name) but as
# mcp-policy-render.service wrote it, as data.mcp.rbac.
# For signed bundles (from mcp-policy-bundle or a bundle server) replace
# ExecStart= with a drop-in from /usr/share/mcp-gateway/opa/.
# Every decision is logged to the journal; policy/mcp/log.rego masks
# tool arguments, and input.context.decision_id links an entry to the
# gateway's audit record.
# OPA_EXTRA_ARGS adds options in every mode, e.g. an OPA configuration file
# for shipping decision logs (decision-logs.conf in /usr/share/mcp-gateway/opa/).
Environment=OPA_EXTRA_ARGS=
ExecStart=/usr/bin/opa run --server \
    --addr unix:///run/mcp-gateway/opa.sock \
    --unix-socket-perm 0660 \
    --watch \
    --log-format json \
    --set=decision_logs.console=true \
    --set=decision_logs.mask_decision=/mcp/log/mask \
    --ignore rbac \
    $OPA_EXTRA_ARGS \
    /usr/share/mcp-gateway/policy \
    mcp:/etc/mcp-gateway/policy \
    mcp.rbac:/run/mcp-opa/rbac
Restart=on-failure

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
UMask=0027

[Install]
WantedBy=multi-user.target
