{
  "version": 1,
  "roles": {
    "suseconnect-reader": {
      "description": "suseconnect: registration status and available extensions",
      "permissions": [
        {
          "server": "suseconnect",
          "tool": "RegistrationStatus"
        },
        {
          "server": "suseconnect",
          "tool": "ListExtensions"
        }
      ]
    },
    "suseconnect-admin": {
      "description": "suseconnect-reader, and with approval: register, activate and deactivate products, deregister",
      "permissions": [
        {
          "server": "suseconnect",
          "tool": "RegistrationStatus"
        },
        {
          "server": "suseconnect",
          "tool": "ListExtensions"
        },
        {
          "server": "suseconnect",
          "tool": "*",
          "require_approval": true,
          "approval_channel": "oob",
          "approval_scopes": [
            "once",
            "session",
            "1h"
          ]
        }
      ]
    }
  }
}
