/usr/bin/mcp-gateway					--	gen_context(system_u:object_r:mcpgw_exec_t,s0)
# One line per directory: a context's specificity is the literal prefix
# before its first regex character, and /usr/(lib|libexec)/... would lose
# to the policy's own /usr/libexec entries.
/usr/lib/mcp-gateway/opa				--	gen_context(system_u:object_r:mcpopa_exec_t,s0)
/usr/libexec/mcp-gateway/opa				--	gen_context(system_u:object_r:mcpopa_exec_t,s0)
/usr/lib/mcp-servers/mcp-(fs(-demo)?|server-fs)		--	gen_context(system_u:object_r:mcpsrv_fs_exec_t,s0)
/usr/libexec/mcp-servers/mcp-(fs(-demo)?|server-fs)	--	gen_context(system_u:object_r:mcpsrv_fs_exec_t,s0)
/usr/lib/mcp-servers/mcp-server-exec			--	gen_context(system_u:object_r:mcpsrv_exec_exec_t,s0)
/usr/libexec/mcp-servers/mcp-server-exec		--	gen_context(system_u:object_r:mcpsrv_exec_exec_t,s0)

/etc/mcp-gateway(/.*)?						gen_context(system_u:object_r:mcpgw_etc_t,s0)
/etc/mcp-gateway/credentials(/.*)?				gen_context(system_u:object_r:mcpgw_cred_t,s0)
/etc/mcp-gateway/bundle/signing\.pem			--	gen_context(system_u:object_r:mcpgw_signing_key_t,s0)
/usr/etc/mcp-gateway(/.*)?					gen_context(system_u:object_r:mcpgw_etc_t,s0)
/var/lib/mcp-gateway(/.*)?					gen_context(system_u:object_r:mcpgw_var_lib_t,s0)
/var/log/mcp-gateway(/.*)?					gen_context(system_u:object_r:mcpgw_log_t,s0)

/run/mcp-gateway					-d	gen_context(system_u:object_r:mcpgw_runtime_t,s0)
/run/mcp-gateway/mcp\.sock				-s	gen_context(system_u:object_r:mcpgw_sock_t,s0)
/run/mcp-gateway/control\.sock				-s	gen_context(system_u:object_r:mcpgw_ctl_sock_t,s0)
/run/mcp-gateway/opa\.sock				-s	gen_context(system_u:object_r:mcpopa_sock_t,s0)
