policy_module(mcp_gateway, 0.1.0)

########################################
#
# Declarations
#
# Policy module for mcp-gateway. It establishes the domains and the
# isolation invariants from docs/architecture.md, section 5.8. For a new
# backend domain, mcp-gateway profile drafts the rules; run it permissive
# (semanage permissive -a) until they are complete.
#

## <desc>
## <p>
## Allow the OPA sidecar to connect to a remote bundle server or a
## decision log collector (HTTP ports).
## </p>
## </desc>
gen_tunable(mcpopa_can_network, false)

## <desc>
## <p>
## Allow mcp-gateway to send approval mail to a mail server
## (notifications.email).
## </p>
## </desc>
gen_tunable(mcpgw_can_send_mail, false)

# All backend MCP server domains.
attribute mcpsrv_domain;

# Gateway daemon.
type mcpgw_t;
type mcpgw_exec_t;
init_daemon_domain(mcpgw_t, mcpgw_exec_t)

type mcpgw_etc_t;
files_config_file(mcpgw_etc_t)

# Backend secrets (/etc/mcp-gateway/credentials); read by systemd for
# LoadCredential=, never by the gateway.
type mcpgw_cred_t;
files_type(mcpgw_cred_t)

# Policy bundle signing key, if the administrator keeps it on the host
# (mcp-policy-bundle -G, signing from Cockpit).
type mcpgw_signing_key_t;
files_type(mcpgw_signing_key_t)

type mcpgw_var_lib_t;
files_type(mcpgw_var_lib_t)

type mcpgw_log_t;
logging_log_file(mcpgw_log_t)

# Remote transport (MCP Streamable HTTP); label the configured port with
#   semanage port -a -t mcp_port_t -p tcp 8443
type mcp_port_t;
corenet_port(mcp_port_t)

# Metrics listener (metrics.listen, plain HTTP); label its port with
#   semanage port -a -t mcp_metrics_port_t -p tcp 9464
type mcp_metrics_port_t;
corenet_port(mcp_metrics_port_t)

# /run/mcp-gateway and the client socket in it.
type mcpgw_runtime_t;
mcp_gateway_runtime_file(mcpgw_runtime_t)
# Created by systemd-tmpfiles (tmpfiles.d/mcp-gateway.conf). Plain rules:
# the interface for this differs between reference policy and openSUSE's.
optional_policy(`
	gen_require(`type systemd_tmpfiles_t;')
	allow systemd_tmpfiles_t mcpgw_runtime_t:dir { manage_dir_perms relabel_dir_perms };
')

type mcpgw_sock_t;
mcp_gateway_runtime_file(mcpgw_sock_t)

# Control socket (Cockpit <-> gateway), administrators only.
type mcpgw_ctl_sock_t;
mcp_gateway_runtime_file(mcpgw_ctl_sock_t)

# OPA sidecar. The distribution's /usr/bin/opa (bin_t) is entered through
# SELinuxContext= in mcp-opa.service; mcpopa_exec_t is for a dedicated copy.
type mcpopa_t;
type mcpopa_exec_t;
init_daemon_domain(mcpopa_t, mcpopa_exec_t)
corecmd_bin_entry_type(mcpopa_t)

type mcpopa_sock_t;
mcp_gateway_runtime_file(mcpopa_sock_t)

# Fallback domain for backends without a dedicated type. Their binaries
# keep their usual label (e.g. bin_t); systemd enters the domain through
# SELinuxContext= in the transient unit.
mcp_gateway_backend_template(generic)
corecmd_bin_entry_type(mcpsrv_generic_t)

# The file server's domain (cmd/mcp-server-fs, package
# mcp-gateway-fs-server; config/servers.d/fs.yaml).
mcp_gateway_backend_template(fs)
mcp_gateway_backend_home_rw(mcpsrv_fs_t)

# The gateway's documentation (the server gateway-docs): mcp-server-fs,
# read-only, in a domain that reads /usr and nothing of the users'.
mcp_gateway_backend_template(docs)
domain_entry_file(mcpsrv_docs_t, mcpsrv_fs_exec_t)
files_read_usr_files(mcpsrv_docs_t)
fs_getattr_xattr_fs(mcpsrv_docs_t)

# Commands an administrator allows (the server exec, cmd/mcp-server-exec,
# package mcp-gateway-exec-server): it reads its command files below
# /etc/mcp-gateway and runs the programs they name, which stay in this
# domain. The rules cover the shipped examples (system state, mounts,
# the rpm database); commands that need more get them from a local
# module (mcp-gateway profile drafts it).
mcp_gateway_backend_template(exec)
# Each command runs in a process group of its own, killed as a whole
# after its timeout.
allow mcpsrv_exec_t self:process { setpgid sigkill signal };
read_files_pattern(mcpsrv_exec_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpsrv_exec_t, mcpgw_etc_t, mcpgw_etc_t)
corecmd_exec_bin(mcpsrv_exec_t)
corecmd_exec_shell(mcpsrv_exec_t)
files_read_usr_files(mcpsrv_exec_t)
auth_use_nsswitch(mcpsrv_exec_t)
kernel_read_kernel_sysctls(mcpsrv_exec_t)
dev_read_sysfs(mcpsrv_exec_t)
fs_getattr_all_fs(mcpsrv_exec_t)
files_getattr_all_mountpoints(mcpsrv_exec_t)
ifdef(`init_read_utmp',`
	init_read_utmp(mcpsrv_exec_t)
')
ifdef(`rpm_read_db',`
	rpm_read_db(mcpsrv_exec_t)
')
# rpm runs in this domain (rpm -q), not in its own.
ifdef(`rpm_exec',`
	rpm_exec(mcpsrv_exec_t)
')
# uptime counts the logged-in users from logind and the terminals in
# /dev/pts (names only; no terminal is opened).
term_list_ptys(mcpsrv_exec_t)
ifdef(`systemd_read_logind_sessions_files',`
	systemd_read_logind_sessions_files(mcpsrv_exec_t)
')
optional_policy(`
	gen_require(`type systemd_logind_sessions_t;')
	list_dirs_pattern(mcpsrv_exec_t, systemd_logind_sessions_t, systemd_logind_sessions_t)
	read_files_pattern(mcpsrv_exec_t, systemd_logind_sessions_t, systemd_logind_sessions_t)
')
# df looks at every mount, also the files the sandbox masks /proc/kmsg
# and the like with; it does without them.
optional_policy(`
	gen_require(`type init_var_run_t;')
	dontaudit mcpsrv_exec_t init_var_run_t:file getattr;
')

# The gateway diagnostics (the server gateway-admin, mcp-gateway
# admin-server): root without capabilities, reading only. It reads the
# configuration, the state directory, the journal and the audit log, file
# labels and SELinux state, asks systemd whether the services run, and
# runs opa on the policy files. Like every server it cannot reach the
# gateway sockets or OPA (the invariants below).
mcp_gateway_backend_template(admin)
domain_entry_file(mcpsrv_admin_t, mcpgw_exec_t)
files_read_usr_files(mcpsrv_admin_t)
read_files_pattern(mcpsrv_admin_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpsrv_admin_t, mcpgw_etc_t, mcpgw_etc_t)
read_lnk_files_pattern(mcpsrv_admin_t, mcpgw_etc_t, mcpgw_etc_t)
files_list_var_lib(mcpsrv_admin_t)
list_dirs_pattern(mcpsrv_admin_t, mcpgw_var_lib_t, mcpgw_var_lib_t)
getattr_files_pattern(mcpsrv_admin_t, mcpgw_var_lib_t, mcpgw_var_lib_t)
auth_use_nsswitch(mcpsrv_admin_t)
corecmd_exec_bin(mcpsrv_admin_t)
# journalctl and ausearch. Interfaces that only some policies define
# (reference policy, openSUSE) are used where defined (ifdef).
logging_search_logs(mcpsrv_admin_t)
logging_read_generic_logs(mcpsrv_admin_t)
logging_read_audit_log(mcpsrv_admin_t)
ifdef(`logging_read_audit_config',`
	logging_read_audit_config(mcpsrv_admin_t)
')
ifdef(`systemd_read_journal_files',`
	systemd_read_journal_files(mcpsrv_admin_t)
')
# The runtime journal (/run/log/journal) where it is syslogd_var_run_t.
optional_policy(`
	gen_require(`type syslogd_var_run_t;')
	list_dirs_pattern(mcpsrv_admin_t, syslogd_var_run_t, syslogd_var_run_t)
	read_files_pattern(mcpsrv_admin_t, syslogd_var_run_t, syslogd_var_run_t)
')
# journalctl looks at the file system of the runtime journal (statfs).
fs_getattr_tmpfs(mcpsrv_admin_t)
# journalctl in its own program type (openSUSE), where it has one.
optional_policy(`
	gen_require(`type journalctl_exec_t;')
	can_exec(mcpsrv_admin_t, journalctl_exec_t)
')
# systemctl is-active: the status of the gateway units.
init_stream_connect(mcpsrv_admin_t)
optional_policy(`
	gen_require(`
		type systemd_unit_file_t;
		class service status;
	')
	allow mcpsrv_admin_t systemd_unit_file_t:service status;
')
ifdef(`systemd_exec_systemctl',`
	systemd_exec_systemctl(mcpsrv_admin_t)
')
ifdef(`init_read_state',`
	init_read_state(mcpsrv_admin_t)
')
# Labels of the server programs, what the policy says they should be,
# whether a type exists, whether /usr is read-only.
files_getattr_all_files(mcpsrv_admin_t)
selinux_get_enforce_mode(mcpsrv_admin_t)
selinux_validate_context(mcpsrv_admin_t)
seutil_read_config(mcpsrv_admin_t)
seutil_read_file_contexts(mcpsrv_admin_t)
fs_getattr_xattr_fs(mcpsrv_admin_t)

########################################
#
# Isolation invariants
#

# Backends must never reach the gateway's sockets or the policy engine.
neverallow mcpsrv_domain { mcpgw_t mcpopa_t }:unix_stream_socket connectto;
neverallow mcpsrv_domain { mcpgw_sock_t mcpgw_ctl_sock_t mcpopa_sock_t }:sock_file write;

# Backends must never modify policy, configuration or gateway state.
neverallow mcpsrv_domain { mcpgw_etc_t mcpgw_var_lib_t }:file { write append create unlink setattr };

# Backend secrets reach backends only through systemd's credentials
# directory; neither the gateway nor the backends read the source files.
neverallow { mcpgw_t mcpsrv_domain } mcpgw_cred_t:file { read open map };

# The bundle signing key is for the administrator only: a compromised
# gateway, policy engine or backend must not be able to sign policy.
neverallow { mcpgw_t mcpopa_t mcpsrv_domain } mcpgw_signing_key_t:file { read open map };

########################################
#
# Gateway local policy
#

allow mcpgw_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_runtime_t)
manage_sock_files_pattern(mcpgw_t, mcpgw_runtime_t, { mcpgw_sock_t mcpgw_ctl_sock_t })
filetrans_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_sock_t, sock_file, "mcp.sock")
filetrans_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_ctl_sock_t, sock_file, "control.sock")

read_files_pattern(mcpgw_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpgw_t, mcpgw_etc_t, mcpgw_etc_t)
# Symlinks in servers.d: a shipped definition linked in (the privileged
# zypp and snapper definitions in /usr/share/mcp-gateway/profiles), or a
# server masked with a link to /dev/null (only stat'ed).
read_lnk_files_pattern(mcpgw_t, mcpgw_etc_t, mcpgw_etc_t)
dev_rw_null(mcpgw_t)
# Vendor backend definitions in /usr/share/mcp-gateway/servers.d.
files_read_usr_files(mcpgw_t)
manage_files_pattern(mcpgw_t, mcpgw_var_lib_t, mcpgw_var_lib_t)
append_files_pattern(mcpgw_t, mcpgw_log_t, mcpgw_log_t)

# Policy decisions.
stream_connect_pattern(mcpgw_t, mcpgw_runtime_t, mcpopa_sock_t, mcpopa_t)

# Backend instances are started by systemd over D-Bus as transient units,
# never exec'd by the gateway itself.
init_dbus_chat(mcpgw_t)
dbus_system_bus_client(mcpgw_t)
# systemd checks StartTransientUnit as system:start on its own context
# (the unit has no file yet). Plain rules: init_start_system and friends
# exist in reference policy only.
gen_require(`
	type init_t;
	class system { start stop status };
')
allow mcpgw_t init_t:system { start stop status };
# Stopping an instance (StopUnit, when the server does not exit after
# its stdin closes) is checked on the unit's file: transient units live
# in /run/systemd/transient, systemd_unit_file_t in Fedora-derived
# policy, systemd_transient_unit_t in the reference policy. polkit
# (50-mcp-gateway.rules) limits the gateway to mcp-*.service units.
optional_policy(`
	gen_require(`
		type systemd_unit_file_t;
		class service { stop status };
	')
	allow mcpgw_t systemd_unit_file_t:service { stop status };
')
optional_policy(`
	gen_require(`
		type systemd_transient_unit_t;
		class service { stop status };
	')
	allow mcpgw_t systemd_transient_unit_t:service { stop status };
')

# The backend's stdio is one end of a socketpair created by the gateway;
# it travels over D-Bus to systemd, which hands it to the backend.
gen_require(`
	type init_t;
')
allow init_t mcpgw_t:fd use;
allow init_t mcpgw_t:unix_stream_socket rw_socket_perms;
# The same for mcp-gateway inspect -server, run by an administrator.
optional_policy(`
	gen_require(`
		type unconfined_t;
	')
	allow init_t unconfined_t:fd use;
	allow init_t unconfined_t:unix_stream_socket rw_socket_perms;
')
allow init_t mcpopa_t:process transition;
# The services run with NoNewPrivileges=. init_daemon_domain grants
# systemd the transition only where the policy defines init_systemd,
# which not every distribution does (Leap 16).
gen_require(`
	class process2 { nnp_transition nosuid_transition };
')
allow init_t { mcpgw_t mcpopa_t }:process2 { nnp_transition nosuid_transition };

# The Go runtime of both probes the transparent huge page size in sysfs
# and does without.
gen_require(`
	type sysfs_t;
')
dontaudit { mcpgw_t mcpopa_t } sysfs_t:dir list_dir_perms;
dontaudit { mcpgw_t mcpopa_t } sysfs_t:file read_file_perms;
allow init_t mcpgw_cred_t:dir list_dir_perms;
allow init_t mcpgw_cred_t:file read_file_perms;

optional_policy(`
	gen_require(`
		type system_dbusd_t;
	')
	allow system_dbusd_t mcpgw_t:fd use;
	allow system_dbusd_t mcpgw_t:unix_stream_socket rw_socket_perms;
')

auth_use_nsswitch(mcpgw_t)
miscfiles_read_localization(mcpgw_t)

# nss-systemd asks PID 1 (io.systemd.DynamicUser) for dynamic users. Where
# PID 1 runs as kernel_t (seen on SLES 16.1) that is not allowed: the lookup
# falls back to the other NSS sources, so only keep it out of the log.
init_stream_connect(mcpgw_t)
gen_require(`
	type kernel_t;
')
dontaudit mcpgw_t kernel_t:unix_stream_socket connectto;

# Type=notify: readiness, status and watchdog pings go to systemd's
# notification socket (/run/systemd/notify; init_stream_connect covers
# the directory and the socket file). Where PID 1 runs as kernel_t (see
# above) the datagrams go to kernel_t: without them systemd would never
# see the gateway ready.
allow mcpgw_t self:unix_dgram_socket create_socket_perms;
allow mcpgw_t { init_t kernel_t }:unix_dgram_socket sendto;

# Approval mail (notifications.email): SMTP when enabled, and getent to
# expand approver groups through NSS.
tunable_policy(`mcpgw_can_send_mail',`
	corenet_tcp_connect_smtp_port(mcpgw_t)
')
corecmd_exec_bin(mcpgw_t)

# A pending restart after an update: the gateway stats its own program
# file (/usr/bin/mcp-gateway) to notice that it was replaced.
allow mcpgw_t mcpgw_exec_t:file getattr;

# SELinux detection (supervisor.SELinuxEnabled).
selinux_get_fs_mount(mcpgw_t)
selinux_get_enforce_mode(mcpgw_t)
# Check at start that the servers' selinux_type exists in the policy
# (security_check_context).
selinux_validate_context(mcpgw_t)

# MCS coordination (supervisor.mcs_avoid): read the contexts of containers,
# virtual machines and libvirt daemons to skip the category pairs they hold
# and to check libvirt's range. Only these domains, not all processes.
kernel_list_proc(mcpgw_t)
# The scan visits every process; only the domains below are readable.
gen_require(`
	attribute domain;
')
dontaudit mcpgw_t domain:dir search_dir_perms;
dontaudit mcpgw_t domain:file read_file_perms;
# Reading a context also checks process getattr; in enforcing mode the
# directory search above fails first, in permissive mode this would log
# one denial per process and scan.
dontaudit mcpgw_t domain:process getattr;
allow mcpgw_t self:process getattr;
optional_policy(`
	gen_require(`type container_t;')
	ps_process_pattern(mcpgw_t, container_t)
')
optional_policy(`
	gen_require(`type container_init_t;')
	ps_process_pattern(mcpgw_t, container_init_t)
')
optional_policy(`
	gen_require(`type container_kvm_t;')
	ps_process_pattern(mcpgw_t, container_kvm_t)
')
optional_policy(`
	gen_require(`type svirt_t;')
	ps_process_pattern(mcpgw_t, svirt_t)
')
optional_policy(`
	gen_require(`type svirt_tcg_t;')
	ps_process_pattern(mcpgw_t, svirt_tcg_t)
')
optional_policy(`
	gen_require(`type virtd_t;')
	ps_process_pattern(mcpgw_t, virtd_t)
')
optional_policy(`
	gen_require(`type virtqemud_t;')
	ps_process_pattern(mcpgw_t, virtqemud_t)
')
# Audit events (denials, approvals, grant revocations, policy changes) go
# to the kernel audit subsystem as AUDIT_TRUSTED_APP records.
logging_send_audit_msgs(mcpgw_t)

# Remote transport: serve HTTPS, and fetch the IdP's discovery document
# and key set.
allow mcpgw_t self:tcp_socket create_stream_socket_perms;
allow mcpgw_t { mcp_port_t mcp_metrics_port_t }:tcp_socket name_bind;
corenet_tcp_bind_generic_node(mcpgw_t)
corenet_tcp_connect_http_port(mcpgw_t)
sysnet_dns_name_resolve(mcpgw_t)
miscfiles_read_generic_certs(mcpgw_t)

########################################
#
# OPA local policy
#

allow mcpopa_t self:unix_stream_socket create_stream_socket_perms;
manage_sock_files_pattern(mcpopa_t, mcpgw_runtime_t, mcpopa_sock_t)
filetrans_pattern(mcpopa_t, mcpgw_runtime_t, mcpopa_sock_t, sock_file, "opa.sock")

# Policy logic in /usr/share/mcp-gateway/policy, role data in
# /etc/mcp-gateway/policy.
read_files_pattern(mcpopa_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpopa_t, mcpgw_etc_t, mcpgw_etc_t)
files_read_usr_files(mcpopa_t)
# opa run --watch (inotify) on both policy directories.
gen_require(`
	type usr_t;
')
allow mcpopa_t { mcpgw_etc_t usr_t }:dir watch;

# Signed bundles (mcp-policy-bundle) in /etc/mcp-gateway/bundle are
# mcpgw_etc_t, readable above.

# Remote bundle server (bundle-server.conf drop-in) and decision log
# collector (decision-logs.conf). Name resolution and
# the CA certificates cannot live inside a conditional; without the
# tunable (and with the default unit's PrivateNetwork=) they are unused.
tunable_policy(`mcpopa_can_network',`
	allow mcpopa_t self:tcp_socket create_stream_socket_perms;
	corenet_tcp_connect_http_port(mcpopa_t)
')
sysnet_dns_name_resolve(mcpopa_t)
miscfiles_read_generic_certs(mcpopa_t)
auth_use_nsswitch(mcpopa_t)

########################################
#
# Go runtime (gateway and OPA)
#
# net.core.somaxconn for listen backlogs; cgroup CPU limits for GOMAXPROCS.
gen_require(`
	type sysctl_t, sysctl_net_t, cgroup_t;
')
allow { mcpgw_t mcpopa_t } sysctl_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } sysctl_net_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } sysctl_net_t:file read_file_perms;
allow { mcpgw_t mcpopa_t } cgroup_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } cgroup_t:file read_file_perms;

########################################
#
# Clients
#
# Which user domains may connect to the gateway (MCP socket) and its
# control API (approvals inbox, e.g. from Cockpit) at all. Everything finer
# grained is decided by OPA and the broker, from the client's identity.
#

optional_policy(`
	gen_require(`
		type unconfined_t;
	')
	mcp_gateway_client(unconfined_t)
	mcp_gateway_control_client(unconfined_t)
')

optional_policy(`
	gen_require(`
		type staff_t;
	')
	mcp_gateway_client(staff_t)
	mcp_gateway_control_client(staff_t)
')

optional_policy(`
	gen_require(`
		type user_t;
	')
	mcp_gateway_client(user_t)
	mcp_gateway_control_client(user_t)
')
