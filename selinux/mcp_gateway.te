policy_module(mcp_gateway, 0.1.0)

########################################
#
# Declarations
#
# Policy module for mcp-gateway. It establishes the domains and the
# isolation invariants from docs/architecture.md, section 5.8. The rules
# below cover the proof-of-concept launch path; run new backend domains
# permissive (semanage permissive -a) until their rules are complete.
#

## <desc>
## <p>
## Allow the OPA sidecar to connect to a remote bundle server.
## </p>
## </desc>
gen_tunable(mcpopa_can_network, false)

## <desc>
## <p>
## Allow mcp-gateway to send approval mail to a mail server
## (notifications.email).
## </p>
## </desc>
gen_tunable(mcpgw_can_send_mail, false)

# All backend MCP server domains.
attribute mcpsrv_domain;

# Gateway daemon.
type mcpgw_t;
type mcpgw_exec_t;
init_daemon_domain(mcpgw_t, mcpgw_exec_t)

type mcpgw_etc_t;
files_config_file(mcpgw_etc_t)

# Backend secrets (/etc/mcp-gateway/credentials); read by systemd for
# LoadCredential=, never by the gateway.
type mcpgw_cred_t;
files_type(mcpgw_cred_t)

# Policy bundle signing key, if the administrator keeps it on the host
# (mcp-policy-bundle -G, signing from Cockpit).
type mcpgw_signing_key_t;
files_type(mcpgw_signing_key_t)

type mcpgw_var_lib_t;
files_type(mcpgw_var_lib_t)

type mcpgw_log_t;
logging_log_file(mcpgw_log_t)

# Remote transport (MCP Streamable HTTP); label the configured port with
#   semanage port -a -t mcp_port_t -p tcp 8443
type mcp_port_t;
corenet_port(mcp_port_t)

# /run/mcp-gateway and the client socket in it.
type mcpgw_runtime_t;
mcp_gateway_runtime_file(mcpgw_runtime_t)
# Created by systemd-tmpfiles (tmpfiles.d/mcp-gateway.conf). Plain rules:
# the interface for this differs between reference policy and openSUSE's.
optional_policy(`
	gen_require(`type systemd_tmpfiles_t;')
	allow systemd_tmpfiles_t mcpgw_runtime_t:dir { manage_dir_perms relabel_dir_perms };
')

type mcpgw_sock_t;
mcp_gateway_runtime_file(mcpgw_sock_t)

# Control socket (Cockpit <-> gateway), administrators only.
type mcpgw_ctl_sock_t;
mcp_gateway_runtime_file(mcpgw_ctl_sock_t)

# OPA sidecar. The distribution's /usr/bin/opa (bin_t) is entered through
# SELinuxContext= in mcp-opa.service; mcpopa_exec_t is for a dedicated copy.
type mcpopa_t;
type mcpopa_exec_t;
init_daemon_domain(mcpopa_t, mcpopa_exec_t)
corecmd_bin_entry_type(mcpopa_t)

type mcpopa_sock_t;
mcp_gateway_runtime_file(mcpopa_sock_t)

# Fallback domain for backends without a dedicated type. Their binaries
# keep their usual label (e.g. bin_t); systemd enters the domain through
# SELinuxContext= in the transient unit.
mcp_gateway_backend_template(generic)
corecmd_bin_entry_type(mcpsrv_generic_t)

# Example dedicated backend domain, see config/servers.d/fs.yaml and
# examples/mcp-fs-demo.
mcp_gateway_backend_template(fs)
mcp_gateway_backend_home_rw(mcpsrv_fs_t)

########################################
#
# Isolation invariants
#

# Backends must never reach the gateway's sockets or the policy engine.
neverallow mcpsrv_domain { mcpgw_t mcpopa_t }:unix_stream_socket connectto;
neverallow mcpsrv_domain { mcpgw_sock_t mcpgw_ctl_sock_t mcpopa_sock_t }:sock_file write;

# Backends must never modify policy, configuration or gateway state.
neverallow mcpsrv_domain { mcpgw_etc_t mcpgw_var_lib_t }:file { write append create unlink setattr };

# Backend secrets reach backends only through systemd's credentials
# directory; neither the gateway nor the backends read the source files.
neverallow { mcpgw_t mcpsrv_domain } mcpgw_cred_t:file { read open map };

# The bundle signing key is for the administrator only: a compromised
# gateway, policy engine or backend must not be able to sign policy.
neverallow { mcpgw_t mcpopa_t mcpsrv_domain } mcpgw_signing_key_t:file { read open map };

########################################
#
# Gateway local policy
#

allow mcpgw_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_runtime_t)
manage_sock_files_pattern(mcpgw_t, mcpgw_runtime_t, { mcpgw_sock_t mcpgw_ctl_sock_t })
filetrans_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_sock_t, sock_file, "mcp.sock")
filetrans_pattern(mcpgw_t, mcpgw_runtime_t, mcpgw_ctl_sock_t, sock_file, "control.sock")

read_files_pattern(mcpgw_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpgw_t, mcpgw_etc_t, mcpgw_etc_t)
# Vendor backend definitions in /usr/share/mcp-gateway/servers.d.
files_read_usr_files(mcpgw_t)
manage_files_pattern(mcpgw_t, mcpgw_var_lib_t, mcpgw_var_lib_t)
append_files_pattern(mcpgw_t, mcpgw_log_t, mcpgw_log_t)

# Policy decisions.
stream_connect_pattern(mcpgw_t, mcpgw_runtime_t, mcpopa_sock_t, mcpopa_t)

# Backend instances are started by systemd over D-Bus as transient units,
# never exec'd by the gateway itself.
init_dbus_chat(mcpgw_t)
dbus_system_bus_client(mcpgw_t)
# systemd checks StartTransientUnit as system:start on its own context
# (the unit has no file yet). Plain rules: init_start_system and friends
# exist in reference policy only.
gen_require(`
	type init_t;
	class system { start stop status };
')
allow mcpgw_t init_t:system { start stop status };

# The backend's stdio is one end of a socketpair created by the gateway;
# it travels over D-Bus to systemd, which hands it to the backend.
gen_require(`
	type init_t;
')
allow init_t mcpgw_t:fd use;
allow init_t mcpgw_t:unix_stream_socket rw_socket_perms;
allow init_t mcpopa_t:process transition;
allow init_t mcpgw_cred_t:dir list_dir_perms;
allow init_t mcpgw_cred_t:file read_file_perms;

optional_policy(`
	gen_require(`
		type system_dbusd_t;
	')
	allow system_dbusd_t mcpgw_t:fd use;
	allow system_dbusd_t mcpgw_t:unix_stream_socket rw_socket_perms;
')

auth_use_nsswitch(mcpgw_t)
miscfiles_read_localization(mcpgw_t)

# Approval mail (notifications.email): SMTP when enabled, and getent to
# expand approver groups through NSS.
tunable_policy(`mcpgw_can_send_mail',`
	corenet_tcp_connect_smtp_port(mcpgw_t)
')
corecmd_exec_bin(mcpgw_t)

# SELinux detection (supervisor.SELinuxEnabled).
selinux_get_fs_mount(mcpgw_t)
selinux_get_enforce_mode(mcpgw_t)

# MCS coordination (supervisor.mcs_avoid): read the contexts of containers,
# virtual machines and libvirt daemons to skip the category pairs they hold
# and to check libvirt's range. Only these domains, not all processes.
kernel_list_proc(mcpgw_t)
# The scan visits every process; only the domains below are readable.
gen_require(`
	attribute domain;
')
dontaudit mcpgw_t domain:dir search_dir_perms;
dontaudit mcpgw_t domain:file read_file_perms;
allow mcpgw_t self:process getattr;
optional_policy(`
	gen_require(`type container_t;')
	ps_process_pattern(mcpgw_t, container_t)
')
optional_policy(`
	gen_require(`type container_init_t;')
	ps_process_pattern(mcpgw_t, container_init_t)
')
optional_policy(`
	gen_require(`type container_kvm_t;')
	ps_process_pattern(mcpgw_t, container_kvm_t)
')
optional_policy(`
	gen_require(`type svirt_t;')
	ps_process_pattern(mcpgw_t, svirt_t)
')
optional_policy(`
	gen_require(`type svirt_tcg_t;')
	ps_process_pattern(mcpgw_t, svirt_tcg_t)
')
optional_policy(`
	gen_require(`type virtd_t;')
	ps_process_pattern(mcpgw_t, virtd_t)
')
optional_policy(`
	gen_require(`type virtqemud_t;')
	ps_process_pattern(mcpgw_t, virtqemud_t)
')
# Audit events (denials, approvals, grant revocations, policy changes) go
# to the kernel audit subsystem as AUDIT_TRUSTED_APP records.
logging_send_audit_msgs(mcpgw_t)

# Remote transport: serve HTTPS, and fetch the IdP's discovery document
# and key set.
allow mcpgw_t self:tcp_socket create_stream_socket_perms;
allow mcpgw_t mcp_port_t:tcp_socket name_bind;
corenet_tcp_bind_generic_node(mcpgw_t)
corenet_tcp_connect_http_port(mcpgw_t)
sysnet_dns_name_resolve(mcpgw_t)
miscfiles_read_generic_certs(mcpgw_t)

########################################
#
# OPA local policy
#

allow mcpopa_t self:unix_stream_socket create_stream_socket_perms;
manage_sock_files_pattern(mcpopa_t, mcpgw_runtime_t, mcpopa_sock_t)
filetrans_pattern(mcpopa_t, mcpgw_runtime_t, mcpopa_sock_t, sock_file, "opa.sock")

# Policy logic in /usr/share/mcp-gateway/policy, role data in
# /etc/mcp-gateway/policy.
read_files_pattern(mcpopa_t, mcpgw_etc_t, mcpgw_etc_t)
list_dirs_pattern(mcpopa_t, mcpgw_etc_t, mcpgw_etc_t)
files_read_usr_files(mcpopa_t)
# opa run --watch (inotify) on both policy directories.
gen_require(`
	type usr_t;
')
allow mcpopa_t { mcpgw_etc_t usr_t }:dir watch;

# Signed bundles (mcp-policy-bundle) in /etc/mcp-gateway/bundle are
# mcpgw_etc_t, readable above.

# Remote bundle server (bundle-server.conf drop-in). Name resolution and
# the CA certificates cannot live inside a conditional; without the
# tunable (and with the default unit's PrivateNetwork=) they are unused.
tunable_policy(`mcpopa_can_network',`
	allow mcpopa_t self:tcp_socket create_stream_socket_perms;
	corenet_tcp_connect_http_port(mcpopa_t)
')
sysnet_dns_name_resolve(mcpopa_t)
miscfiles_read_generic_certs(mcpopa_t)
auth_use_nsswitch(mcpopa_t)

########################################
#
# Go runtime (gateway and OPA)
#
# net.core.somaxconn for listen backlogs; cgroup CPU limits for GOMAXPROCS.
gen_require(`
	type sysctl_t, sysctl_net_t, cgroup_t;
')
allow { mcpgw_t mcpopa_t } sysctl_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } sysctl_net_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } sysctl_net_t:file read_file_perms;
allow { mcpgw_t mcpopa_t } cgroup_t:dir search_dir_perms;
allow { mcpgw_t mcpopa_t } cgroup_t:file read_file_perms;

########################################
#
# Clients
#
# Which user domains may connect to the gateway (MCP socket) and its
# control API (approvals inbox, e.g. from Cockpit) at all. Everything finer
# grained is decided by OPA and the broker, from the client's identity.
#

optional_policy(`
	gen_require(`
		type unconfined_t;
	')
	mcp_gateway_client(unconfined_t)
	mcp_gateway_control_client(unconfined_t)
')

optional_policy(`
	gen_require(`
		type staff_t;
	')
	mcp_gateway_client(staff_t)
	mcp_gateway_control_client(staff_t)
')

optional_policy(`
	gen_require(`
		type user_t;
	')
	mcp_gateway_client(user_t)
	mcp_gateway_control_client(user_t)
')
