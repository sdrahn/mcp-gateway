# Commands an administrator allows, as an MCP server (package
# mcp-gateway-exec-server): each command in /etc/mcp-gateway/exec.d/*.yaml
# is one tool, run without a shell, as the calling user, without network,
# in the mcpsrv_exec_t domain. None are configured at first; examples are
# in @DATADIR@/mcp-gateway/exec/examples.yaml. Users need a role for the
# server: the shipped exec-operator runs every command with approval.
# To change this definition, copy it to
# /etc/mcp-gateway/servers.d/exec.yaml; an empty file of that name
# disables it.
version: 1
name: exec
command: ["@LIBEXECDIR@/mcp-servers/mcp-server-exec", "--commands", "/etc/mcp-gateway/exec.d",
  "--instructions", "Commands run as you (the user the agent acts for), without network, confined by SELinux (mcpsrv_exec_t): reading or changing more than /etc, /usr and the system's state may be refused even where your account could. The administrator chooses the commands (/etc/mcp-gateway/exec.d); the gateway's policy decides who may run which, some only after an approval."]
selinux_type: mcpsrv_exec_t
network: false
# Landlock: the commands read the system and its state (/var, /run, as
# the instructions say) and write only temporary files; no home
# directory.
landlock:
  read: ["/var", "/run"]
