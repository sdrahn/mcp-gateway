// Allow the gateway to start and stop its backend instances, which run as
// transient units named mcp-<backend>-<session>.service, and nothing else.
//
// To be verified in the proof of concept: that systemd passes the "unit"
// detail for StartTransientUnit on all target distributions.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "mcp-gateway") {
        var unit = action.lookup("unit");
        if (unit && /^mcp-[a-z0-9-]+\.service$/.test(unit)) {
            return polkit.Result.YES;
        }
    }
});
