// Allow the gateway to start and stop its backend instances, which run as
// transient units named mcp-<backend>-<session>.service, and nothing else.
//
// systemd passes the unit name as the "unit" detail for StartTransientUnit;
// the VM tests (Leap 16, Tumbleweed) start every instance through this rule.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "mcp-gateway") {
        var unit = action.lookup("unit");
        if (unit && /^mcp-[a-z0-9-]+\.service$/.test(unit)) {
            return polkit.Result.YES;
        }
    }
});
