{
  "roles": {
    "viewer": {
      "permissions": [
        {
          "server": "*",
          "tool": "list_*"
        },
        {
          "server": "*",
          "tool": "read_*"
        },
        {
          "server": "*",
          "tool": "get_*"
        }
      ]
    },
    "developer": {
      "permissions": [
        {
          "server": "git",
          "tool": "*"
        },
        {
          "server": "fs",
          "tool": "read_*"
        },
        {
          "server": "fs",
          "tool": "list_*"
        },
        {
          "server": "fs",
          "tool": "write_file",
          "require_approval": true,
          "approval_channel": "url",
          "args": {
            "path": "^${home}/"
          }
        },
        {
          "server": "fs",
          "tool": "delete_*",
          "effect": "deny"
        }
      ]
    },
    "admin": {
      "permissions": [
        {
          "server": "*",
          "tool": "*"
        }
      ]
    }
  },
  "bindings": {
    "groups": {
      "dev": [
        "developer"
      ],
      "wheel": [
        "admin"
      ]
    },
    "users": {}
  },
  "approvers": {
    "default": [
      "self",
      "role:admin"
    ]
  }
}
