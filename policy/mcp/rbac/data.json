{
  "version": 1,
  "roles": {
    "viewer": {
      "permissions": [
        {"server": "*", "tool": "list_*"},
        {"server": "*", "tool": "read_*"},
        {"server": "*", "tool": "get_*"},
        {"server": "gateway-docs", "tool": "*"},
        {"server": "gateway-docs", "resource": "*"},
        {"server": "*", "prompt": "*"}
      ]
    },
    "developer": {
      "permissions": [
        {"server": "git", "tool": "*"},
        {"server": "fs", "tool": "read_*"},
        {"server": "fs", "tool": "list_*"},
        {"server": "fs", "resource": "file://${home}/*"},
        {"server": "fs", "tool": "search_files"},
        {"server": "fs", "tool": "search_text"},
        {"server": "fs", "tool": "directory_tree"},
        {"server": "fs", "tool": "get_file_info"},
        {"server": "fs", "tool": "write_file", "require_approval": true, "approval_channel": "url", "args": {"path": "^${home}/"}},
        {"server": "fs", "tool": "edit_file", "require_approval": true, "approval_channel": "url", "args": {"path": "^${home}/"}},
        {"server": "fs", "tool": "create_directory", "require_approval": true, "approval_channel": "url", "args": {"path": "^${home}/"}},
        {"server": "fs", "tool": "move_file", "require_approval": true, "approval_channel": "url", "args": {"source": "^${home}/", "destination": "^${home}/"}},
        {"server": "fs", "tool": "delete_*", "effect": "deny"},
        {"server": "gateway-docs", "tool": "*"},
        {"server": "gateway-docs", "resource": "*"},
        {"server": "*", "prompt": "*"}
      ]
    },
    "admin": {
      "permissions": [
        {"server": "*", "tool": "*"},
        {"server": "*", "prompt": "*"},
        {"server": "*", "resource": "*"},
        {"server": "*", "client": "*"}
      ]
    }
  },
  "bindings": {"groups": {"dev": ["developer"], "wheel": ["admin"]}, "users": {}},
  "approvers": {"default": ["self", "role:admin"]}
}
