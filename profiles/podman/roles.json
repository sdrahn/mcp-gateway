{
  "version": 1,
  "roles": {
    "podman-reader": {
      "description": "podman: list and inspect your own containers, images, networks and volumes, and read container logs",
      "permissions": [
        {
          "server": "podman",
          "tool": "container_list"
        },
        {
          "server": "podman",
          "tool": "container_inspect"
        },
        {
          "server": "podman",
          "tool": "container_logs"
        },
        {
          "server": "podman",
          "tool": "image_list"
        },
        {
          "server": "podman",
          "tool": "network_list"
        },
        {
          "server": "podman",
          "tool": "volume_list"
        }
      ]
    },
    "podman-operator": {
      "description": "podman-reader, and with approval: run, stop and remove containers, pull, build, push and remove images",
      "permissions": [
        {
          "server": "podman",
          "tool": "container_list"
        },
        {
          "server": "podman",
          "tool": "container_inspect"
        },
        {
          "server": "podman",
          "tool": "container_logs"
        },
        {
          "server": "podman",
          "tool": "image_list"
        },
        {
          "server": "podman",
          "tool": "network_list"
        },
        {
          "server": "podman",
          "tool": "volume_list"
        },
        {
          "server": "podman",
          "tool": "*",
          "require_approval": true,
          "approval_channel": "oob",
          "approval_scopes": [
            "once",
            "session",
            "1h"
          ]
        }
      ]
    }
  }
}
